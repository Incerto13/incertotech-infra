# Build-time values for the LOCAL k8s overlay (minikube).
# Sourced by bin/start-local-k8s.sh before building images. Nothing here is
# secret — these are just the *.incertotech.local hostnames served by the
# minikube ingress. They play the same role as the "ENV=dev" block of the
# root .env does for docker-compose.
#
# homepage links (expanded into index.html by expand-homepage-links.sh)
REACT_TO_DO_URL=https://react-to-do.incertotech.local
REACT_ELECTORAL_MAP_URL=https://react-electoral-map.incertotech.local
REACT_COURSE_ADMIN_URL=https://react-course-admin.incertotech.local
NEST_TO_DO_API_URL=https://nest-to-do-api.incertotech.local
NEST_BLOG_API_URL=https://nest-blog-api.incertotech.local
NEST_COURSE_ADMIN_API_URL=https://nest-course-admin-api.incertotech.local

# React API base URLs (baked into the web bundles at build time)
REACT_APP_TO_DO_SERVER_URL=https://react-to-do.incertotech.local/api
REACT_APP_COURSE_ADMIN_SERVER_URL=https://react-course-admin.incertotech.local/api
# node-ecommerce isn't in the cluster yet; it runs via its own docker-compose on :8006
NODE_ECOMMERCE_URL=http://localhost:8006
# django-blog isn't in the cluster yet; it runs via its own docker-compose on :8001
DJANGO_BLOG_URL=http://localhost:8001
