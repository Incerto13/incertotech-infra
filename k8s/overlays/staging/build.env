# Build-time values for the STAGING overlay. Sourced by bin/k8s-build-images.sh
# (run by .github/workflows/k8s-deploy.yml) before building the images. Nothing
# here is secret — these are the public hostnames, baked into the React bundles
# and the homepage's index.html at build time.
#
# homepage links (expanded into index.html by expand-homepage-links.sh)
REACT_TO_DO_URL=https://react-to-do.staging.incertotech.com
REACT_ELECTORAL_MAP_URL=https://react-electoral-map.staging.incertotech.com
REACT_COURSE_ADMIN_URL=https://react-course-admin.staging.incertotech.com
NEST_TO_DO_API_URL=https://nest-to-do-api.staging.incertotech.com
NEST_BLOG_API_URL=https://nest-blog-api.staging.incertotech.com
NEST_COURSE_ADMIN_API_URL=https://nest-course-admin-api.staging.incertotech.com
NODE_ECOMMERCE_URL=https://node-ecommerce.staging.incertotech.com
DJANGO_BLOG_URL=https://django-blog.staging.incertotech.com

# React API base URLs (baked into the web bundles at build time)
REACT_APP_TO_DO_SERVER_URL=https://react-to-do.staging.incertotech.com/api
REACT_APP_COURSE_ADMIN_SERVER_URL=https://react-course-admin.staging.incertotech.com/api
